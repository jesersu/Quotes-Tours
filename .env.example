# Copy to .env (git-ignored) and fill in. Never commit real credentials.

# Read-only connection used by the generator (role `quotes_generator`).
# Through the Supabase pooler the username is `quotes_generator.<project-ref>`.
# Format: postgresql://quotes_generator.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=

# Throwaway Postgres for integration tests ONLY. The tests DROP and recreate the `quotes`
# schema in this database, so never point it at real data.
# Format: postgresql://<user>:<password>@localhost:5432/<scratch-database>
TEST_DATABASE_URL=
